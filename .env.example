# ─── Telegram ───────────────────────────────────────────────
BOT_TOKEN=1234567890:AAAA...your...bot...token

# ─── База данных ────────────────────────────────────────────
DB_PATH=/data/flowvpn.db

# ─── WebApp (Mini App) ──────────────────────────────────────
# Порт веб-сервера (на многих хостингах задаётся автоматически через PORT)
PORT=8000
MINIAPP_URL=https://your-hosting-domain.example

# ─── ЮKassa ─────────────────────────────────────────────────
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ─── 3x-UI панель ───────────────────────────────────────────
# Адрес самой панели (как открываешь в браузере)
XUI_HOST=https://sub.flowvpn.su:2053
XUI_USERNAME=admin
XUI_PASSWORD=твой_пароль_от_панели

# Либо API-токен вместо логина/пароля (Settings → Security → API Token):
# XUI_TOKEN=

# Проверка TLS-сертификата панели: 1 = проверять, 0 = не проверять
# XUI_TLS_VERIFY=0

# Локации (inbounds) для новых ключей — ОБЕ СРАЗУ, через запятую.
# Посмотреть ID можно в панели: Inbounds → колонка ID.
# Если оставить пустым — бот сам возьмёт ВСЕ inbound'ы из панели.
XUI_INBOUND_IDS=1,2

# Флаги для локаций: бот сводит remark inbound'а к ТОЛЬКО флагу,
# а шаблон {{INBOUND}}{{EMAIL}} даёт имя «🇫🇮tg8355628654-1gb».
# Необязательно: без этого бот сам распознает страну по тексту remark
# (Finland/Финляндия/Helsinki…) и сведёт remark к флагу.
# Формат: id=Флаг (или название страны — бот выделит флаг)
# XUI_INBOUND_REMARKS=1=🇫🇮,2=🇩🇪

# ─── Ссылка подписки (sub-сервер 3x-ui) ─────────────────────
# Итоговая ссылка юзера: https://XUI_SUB_HOST:XUI_SUB_PORT/XUI_SUB_PATH/<subId>
XUI_SUB_HOST=sub.flowvpn.su
XUI_SUB_PORT=2053
XUI_SUB_PATH=3o3ntto7rlvdmgtv
# https (1) или http (0)
# XUI_SUB_SECURE=1
